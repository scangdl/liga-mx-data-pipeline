# ============================================================
# Liga MX Pipeline - Environment Variables Template
# Copy to .env and fill in your secrets
# ============================================================

# Odds API (the-odds-api.com) - Required for odds fetching
# Get your free API key at https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# Sportmonks API - Optional, for richer data (14-day trial)
# Get token at https://www.sportmonks.com/
SPORTMONKS_TOKEN=your_sportmonks_token_here

# Telegram Bot - Optional, for decay detector alerts
# Create bot via @BotFather, get chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Webhook - Optional, alternative alerting
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Twilio WhatsApp - Optional, for WhatsApp alerts
# Get credentials at https://www.twilio.com/try-twilio
# WhatsApp Sandbox: Console -> Messaging -> Try it out -> WhatsApp
# Join sandbox: send "join <code>" to +14155238886
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+521xxxxxxxxxx

# MLflow Tracking - Optional, for experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# Custom data directory (overrides config.yaml paths.data_dir)
# LIGA_MX_DATA_DIR=/custom/path/to/data

# Custom model directory (overrides config.yaml paths.models_dir)
# LIGA_MX_MODELS_DIR=/custom/path/to/models

# Log level override (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=DEBUG

# Timezone for cron scheduling (IANA format)
# TIMEZONE=America/Mexico_City